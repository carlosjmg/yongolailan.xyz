# ─────────────────────────────────────────────────────────────
# Yongolailan site — environment variables
# Copy this file to ".env" for local development and fill in values.
# In production (Vercel), set these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Database.
#   Local dev (default):   file:./dev.db   (SQLite — zero setup)
#   Production (Vercel):    the Postgres connection string from Vercel Storage
DATABASE_URL="file:./dev.db"

# Admin panel login (choose a strong password for production).
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Must be >= 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="please-change-this-to-a-long-random-string-32chars-min"

# Public site URL (used for links in emails, sitemap, canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email (Resend). Leave RESEND_API_KEY blank locally to log emails to the
# console instead of sending them.
RESEND_API_KEY=""
CONTACT_TO_EMAIL="yongolailan.official@gmail.com"
# Until the domain is verified in Resend, use "onboarding@resend.dev".
EMAIL_FROM="Yongolailan <onboarding@resend.dev>"

# File uploads (Vercel Blob). Leave blank locally to save uploads to
# /public/uploads instead. In production this is set automatically by Vercel.
BLOB_READ_WRITE_TOKEN=""
